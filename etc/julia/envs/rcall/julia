#!/bin/sh
#set -x
#JULIA_LIB=$(LD_LIBRARY_PATH="" julia -e 'println(joinpath(dirname(Sys.BINDIR), "lib", "julia"))')

export JULIA_DIST="$(juliaup status | grep '\*' | awk '{print $3}')"

export JULIA_EXE="$(which julia)"
export JULIA_BASEDIR="$(realpath $HOME/.julia/juliaup/julia-$JULIA_DIST)"
export JULIA_BINDIR="$JULIA_BASEDIR/bin"
export JULIA_LIBDIR="$JULIA_BASEDIR/lib"

# export LD_LIBRARY_PATH="/usr/local/lib/R/lib:${LD_LIBRARY_PATH}"

if [ -f /usr/local/lib/R/etc/ldpaths ]; then
    .  /usr/local/lib/R/etc/ldpaths
fi    

export LD_LIBRARY_PATH="$JULIA_LIBDIR:$JULIA_LIBDIR/julia:${LD_LIBRARY_PATH}"

export JULIA_PROJECT="$(dirname "$(realpath "$0")")"

exec "$JULIA_EXE" --project="$JULIA_PROJECT" "$@"
