# {{{ [ ENVIRONMENT ] /////////////////////////////////////////////////////////////

# ===( .env )===================================================================

# Ignore all dotenv files...
.env
.env.*

# except for .env.defaults
!.env.defaults



# {{{ [ GENERAL ] /////////////////////////////////////////////////////////////

# ===( Git )===================================================================

# Ignore all dotfiles...
#.*
# except for .gitignore
!.gitignore
!.gitattributes

!.dockerignore
!.travis.yml

